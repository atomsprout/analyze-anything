{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Analyze Anything",
  "identifier": "com.atomsprout.analyze-anything",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Analyze Anything",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "report:",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 atomsprout. Apache-2.0.",
    "shortDescription": "Analyze any app package, installer or file and read the report",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "fileAssociations": [
      {
        "ext": [
          "ipa",
          "apk",
          "aab",
          "xapk",
          "apks",
          "dmg",
          "pkg",
          "app",
          "zip",
          "7z",
          "tar",
          "gz",
          "tgz",
          "exe",
          "msi",
          "dll",
          "jar",
          "deb",
          "rpm"
        ],
        "name": "Package or archive",
        "role": "Viewer"
      }
    ]
  }
}
